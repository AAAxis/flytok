rules_version = '2';

// Production rules for Roamrez/Flytok (project: roamerz-b0056).
// Schema documented in firebase/README.md; client paths verified against
// mobile/lib/firestore.ts and src/lib/repositories/*.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // True iff the diff between old and new doc only touches the named fields.
    // Used to allow distributed counter updates without granting full write.
    function onlyAffects(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // === users/{uid} ===
    // Public profiles: any signed-in user can read so feeds, inbox, mentions,
    // and the new-chat picker can resolve display names. Only the user
    // themselves (or an admin) can write.
    //
    // Self-writable fields (W1+): displayName, displayNameLower (denormalised
    // for prefix search), photoURL, bio, discoverable (default true; opt-out
    // hides the user from global handle search), email, lastSeenAt.
    // W2 added a `theme` map (preset, backgroundColor, accentColor,
    // backgroundImageURL, backgroundImagePath, avatarStyle, avatarSeed) —
    // covered by the existing isSelf(uid) write rule.
    // W3 added `preferred_searches: string[]`. Validation runs as part of
    // the existing self-write rule but is bounded by a helper below so a
    // bad client can't bloat the doc.
    function preferredSearchesValid() {
      return !('preferred_searches' in request.resource.data)
             || (request.resource.data.preferred_searches is list
                 && request.resource.data.preferred_searches.size() <= 20);
    }
    match /users/{uid} {
      allow read:           if signedIn();
      allow create, update: if (isSelf(uid) || isAdmin())
                            && preferredSearchesValid();
      allow delete:         if isAdmin();

      // Saved-videos list — strictly private to the owning user.
      match /saves/{videoId} {
        allow read, write: if isSelf(uid);
      }

      // following/{targetUid}: writes only by the path-owner (i.e. self
      // adding/removing someone they follow). Reads available to any
      // signed-in user so follow lists / counts work.
      match /following/{targetUid} {
        allow read:           if signedIn();
        allow create, delete: if isSelf(uid);
        allow update:         if false;
      }

      // followers/{followerUid}: doc id IS the follower's uid. follow() in
      // firestore.ts mirrors writes here on behalf of the follower.
      match /followers/{followerUid} {
        allow read:           if signedIn();
        allow create, delete: if isSelf(followerUid);
        allow update:         if false;
      }

      // Block list — private to self.
      match /blocked/{otherUid} {
        allow read, write: if isSelf(uid);
      }
    }

    // === videos/{videoId} ===
    match /videos/{videoId} {
      allow read: if signedIn();

      // Owner-only creation; ownerId must match the caller.
      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid;

      // Owner edits caption/hashtags; admin can also moderate.
      // Any signed-in user may touch ONLY the denormalized counters
      // (likeCount, commentCount) — these are mutated by toggleLike() and
      // postComment() running on the client.
      allow update: if isAdmin()
                    || (signedIn() && resource.data.ownerId == request.auth.uid)
                    || (signedIn() && onlyAffects(['likeCount', 'commentCount']));

      allow delete: if isAdmin()
                    || (signedIn() && resource.data.ownerId == request.auth.uid);

      // Comments: anyone signed-in reads/posts; author or admin deletes.
      match /comments/{commentId} {
        allow read:   if signedIn();
        allow create: if signedIn()
                      && request.resource.data.authorId == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin()
                      || (signedIn() && resource.data.authorId == request.auth.uid);
      }

      // Likes: doc id is the liker's uid (matches likesCol(videoId).doc(uid)).
      // Only that user may add/remove their own like.
      match /likes/{likeUid} {
        allow read:           if signedIn();
        allow create, delete: if isSelf(likeUid);
        allow update:         if false;
      }
    }

    // === threads/{threadId} (1:1 DMs) ===
    // threadId convention: sorted([uidA, uidB]).join('_'). Membership is
    // proven by the participants array on the parent doc.
    match /threads/{threadId} {
      function isParticipant() {
        return signedIn() && (request.auth.uid in resource.data.participants);
      }
      function willBeParticipant() {
        return signedIn()
               && (request.auth.uid in request.resource.data.participants)
               && request.resource.data.participants.size() == 2;
      }

      allow read:   if isParticipant();
      allow create: if willBeParticipant();
      // Updates (e.g. lastMessage/lastMessageAt with merge:true) keep
      // existing participants intact, so isParticipant() is sufficient.
      allow update: if isParticipant();
      allow delete: if false;

      match /messages/{messageId} {
        function inThread() {
          return signedIn() && (request.auth.uid in
            get(/databases/$(database)/documents/threads/$(threadId)).data.participants);
        }
        allow read:   if inThread();
        allow create: if inThread()
                      && request.resource.data.authorId == request.auth.uid;
        // Soft delete: the original author may set ONLY `deletedAt` and
        // `deletedBy`. Edits to text/image/video payloads remain forbidden.
        allow update: if inThread()
                      && resource.data.authorId == request.auth.uid
                      && request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasOnly(['deletedAt', 'deletedBy']);
        // Hard delete remains forbidden — soft-delete is the only path.
        allow delete: if false;
      }
    }

    // === places/{slug} ===
    // Aggregator collection — written ONLY by the
    // `onVideoCreatePlaceCounter` Cloud Function (running with service-
    // account creds, which bypass these rules). Every signed-in client can
    // read so the search screen can prefix-search by `label_lower`.
    match /places/{slug} {
      allow read:                   if signedIn();
      allow create, update, delete: if false;
    }

    // === trending_places/{docId} ===
    // Single doc (`snapshot`) written by the `rebuildTrendingPlaces`
    // scheduled function. Same shape as places — read-only to clients.
    match /trending_places/{docId} {
      allow read:                   if signedIn();
      allow create, update, delete: if false;
    }

    // === reports/{reportId} ===
    // Created by any signed-in user; only admins (moderation console) read.
    match /reports/{reportId} {
      allow read:           if isAdmin();
      allow create:         if signedIn()
                            && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Default deny — any collection not matched above is forbidden.
  }
}
