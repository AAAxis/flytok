{
  "expo": {
    "name": "Roamerz",
    "slug": "flytok",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flytok",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.roamrez.flytok",
      "googleServicesFile": "../firebase/GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Roamerz uses the camera to record travel videos.",
        "NSPhotoLibraryUsageDescription": "Roamerz needs access to your photo library to upload travel videos.",
        "NSMicrophoneUsageDescription": "Roamerz records audio with your travel videos.",
        "NSLocationWhenInUseUsageDescription": "Roamerz uses your location to show nearby places on the map and tag uploads."
      }
    },
    "android": {
      "package": "com.roamrez.flytok",
      "googleServicesFile": "../firebase/google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidLargeHeap.js",
      "./plugins/withGoogleMapsApiKey.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Roamerz accesses your photos to let you upload travel videos.",
          "cameraPermission": "Roamerz accesses your camera to record travel videos.",
          "microphonePermission": "Roamerz records audio with your travel videos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Roamerz uses the camera to record travel videos.",
          "microphonePermission": "Roamerz records audio while you record videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Roamerz uses your location to show nearby places on the map."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Roamerz uses this to deliver more relevant content and measure ads. Your data is not shared with third parties for advertising."
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
